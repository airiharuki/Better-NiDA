c Khmer Better-NiDA (Midpoint) - Keyman keyboard source
c Generated by scripts/build_platform_layouts.ps1 from midpoint_layout.json.
c DO NOT EDIT BY HAND - edit scripts/midpoint_engine.ps1 and regenerate.
c
c Zero display lag: every key emits its base character immediately, and
c multi-key sequences (k/, jj, j/, ii, ua, ai, double-space) replace the
c already-emitted context inline on the completing keystroke.

store(&VERSION) '10.0'
store(&NAME) 'Khmer Better-NiDA (Midpoint)'
store(&COPYRIGHT) '(c) 2026 Better-NiDA Contributors'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'windows macosx linux web'

begin Unicode > use(main)

group(main) using keys

c --- contextual sequence rules (Rules 1, 2, 3) ---
U+1780 + [K_SLASH] > U+1782   c k/ (Rule 1: consonant series/aspirated flip)
U+1782 + [K_SLASH] > U+1781   c x/ (Rule 1: consonant series/aspirated flip)
U+1781 + [K_SLASH] > U+1783   c x// (Rule 1: consonant series/aspirated flip)
U+1785 + [K_SLASH] > U+1787   c c/ (Rule 1: consonant series/aspirated flip)
U+1787 + [K_SLASH] > U+1786   c q/ (Rule 1: consonant series/aspirated flip)
U+1786 + [K_SLASH] > U+1788   c q// (Rule 1: consonant series/aspirated flip)
U+178A + [K_SLASH] > U+178C   c d/ (Rule 1: consonant series/aspirated flip)
U+1789 + [K_SLASH] > U+1789 U+17C9   c z/ (Rule 1: consonant series/aspirated flip)
U+1789 + [K_Z] > U+178B   c zz (Rule 1: consonant series/aspirated flip)
U+178B + [K_SLASH] > U+178D   c zz/ (Rule 1: consonant series/aspirated flip)
U+178F + [K_SLASH] > U+1791   c t/ (Rule 1: consonant series/aspirated flip)
U+1791 + [K_SLASH] > U+1790   c f/ (Rule 1: consonant series/aspirated flip)
U+1790 + [K_SLASH] > U+1792   c f// (Rule 1: consonant series/aspirated flip)
U+1794 + [K_SLASH] > U+1796   c b/ (Rule 1: consonant series/aspirated flip)
U+1796 + [K_SLASH] > U+1795   c p/ (Rule 1: consonant series/aspirated flip)
U+1795 + [K_SLASH] > U+1797   c p// (Rule 1: consonant series/aspirated flip)
U+1793 + [K_SLASH] > U+178E   c n/ (Rule 1: consonant series/aspirated flip)
U+179B + [K_SLASH] > U+17A1   c l/ (Rule 1: consonant series/aspirated flip)
U+1784 + [K_SLASH] > U+17A2   c g/ (Rule 1: consonant series/aspirated flip)
U+1798 + [K_SLASH] > U+1798 U+17C9   c m/ (Rule 1: sonorant + muusikatoan)
U+1799 + [K_SLASH] > U+1799 U+17C9   c y/ (Rule 1: sonorant + muusikatoan)
U+179A + [K_SLASH] > U+179A U+17C9   c r/ (Rule 1: sonorant + muusikatoan)
U+179C + [K_SLASH] > U+179C U+17C9   c v/ (Rule 1: sonorant + muusikatoan)
U+179F + [K_SLASH] > U+179F U+17CA   c s/ (Rule 1: fricative + traysap)
U+17A0 + [K_SLASH] > U+17A0 U+17CA   c h/ (Rule 1: fricative + traysap)
U+17D2 + [K_J] > U+1789   c jj (Rule 2: double-tap j -> nyo)
U+17D2 + [K_SLASH] > U+17D2 U+1789   c j/ (Rule 2: coeng + nyo)
U+17B7 + [K_I] > U+17B8   c ii (Rule 3: double-tap upgrade)
U+17BB + [K_U] > U+17BC   c uu (Rule 3: double-tap upgrade)
U+17C1 + [K_E] > U+17C2   c ee (Rule 3: double-tap upgrade)
U+17B9 + [K_W] > U+17BA   c ww (Rule 3: double-tap upgrade)
U+17C4 + [K_O] > U+17C5   c oo (Rule 3: double-tap upgrade)
U+17C0 + [K_LBRKT] > U+17BF   c [[ (Rule 3: double-tap upgrade)
U+17D4 + [K_PERIOD] > U+17D5   c .. (Rule 3: double-tap upgrade)
U+17B6 + [K_A] > U+17B6 U+17C6   c aa (Rule 3: double-tap upgrade)
U+17BE + [K_COLON] > U+17C4 U+17C7   c ;; (Rule 3: double-tap upgrade)
U+17CB + [K_QUOTE] > U+17C9   c '' (Rule 3: double-tap upgrade)
U+17BB U+17C6 + [K_COMMA] > U+17BB U+17C7   c ,, (Rule 3: double-tap upgrade)
U+17C6 + [K_RBRKT] > U+17A7   c ]] (Rule 3: double-tap upgrade)
U+17C7 + [K_BKSLASH] > U+17C8   c \\ (Rule 3: double-tap upgrade)
U+1799 + [K_Y] > U+17BD   c yy (Rule 3: double-tap upgrade)
U+179C + [K_V] > U+17C1 U+17C7   c vv (Rule 3: double-tap upgrade)
U+179A + [K_R] > U+17AC   c rr (Rule 3: double-tap upgrade)
U+00AB + [K_BKQUOTE] > U+00BB   c `` (Rule 3: double-tap upgrade)
U+17A2 + [K_HYPHEN] > U+17CC   c -- (Rule 3: double-tap upgrade)
U+17C3 + [K_EQUAL] > U+003D   c == (Rule 3: double-tap upgrade)
U+17CA + [K_SLASH] > U+003F   c // (Rule 3: double-tap upgrade)
U+200B + [K_SPACE] > U+0020   c    (Rule 3: double-tap upgrade)
U+17B7 + [K_SLASH] > U+17B8   c i/ (Rule 3: universal slash upgrade)
U+17BB + [K_SLASH] > U+17BC   c u/ (Rule 3: universal slash upgrade)
U+17C1 + [K_SLASH] > U+17C2   c e/ (Rule 3: universal slash upgrade)
U+17B9 + [K_SLASH] > U+17BA   c w/ (Rule 3: universal slash upgrade)
U+17C4 + [K_SLASH] > U+17C5   c o/ (Rule 3: universal slash upgrade)
U+17C0 + [K_SLASH] > U+17BF   c [/ (Rule 3: universal slash upgrade)
U+17B6 + [K_SLASH] > U+17B6 U+17C6   c a/ (Rule 3: universal slash upgrade)
U+17BE + [K_SLASH] > U+17C4 U+17C7   c ;/ (Rule 3: universal slash upgrade)
U+17C4 U+17C7 + [K_SLASH] > U+17D6   c ;// (Rule 3: universal slash upgrade)
U+17CB + [K_SLASH] > U+17C9   c '/ (Rule 3: universal slash upgrade)
U+17C9 + [K_SLASH] > U+17C8   c '// (Rule 3: universal slash upgrade)
U+17BB U+17C6 + [K_SLASH] > U+17BB U+17C7   c ,/ (Rule 3: universal slash upgrade)
U+17BB U+17C7 + [K_SLASH] > U+002C   c ,// (Rule 3: universal slash upgrade)
U+17D4 + [K_SLASH] > U+17D5   c ./ (Rule 3: universal slash upgrade)
U+17D5 + [K_SLASH] > U+002E   c .// (Rule 3: universal slash upgrade)
U+17C6 + [K_SLASH] > U+17A7   c ]/ (Rule 3: universal slash upgrade)
U+17A7 + [K_SLASH] > U+17AA   c ]// (Rule 3: universal slash upgrade)
U+17C7 + [K_SLASH] > U+17C8   c \/ (Rule 3: universal slash upgrade)
U+17C8 + [K_SLASH] > U+17AD   c \// (Rule 3: universal slash upgrade)
U+00AB + [K_SLASH] > U+00BB   c `/ (Rule 3: universal slash upgrade)
U+200B + [K_SLASH] > U+0020   c  / (Rule 3: universal slash upgrade)
U+003F + [K_SLASH] > U+002F   c /// (Rule 3: universal slash upgrade)
U+17AC + [K_SLASH] > U+17AB   c rr/ (Rule 3: universal slash upgrade)
U+17CC + [K_SLASH] > U+17A5   c --/ (Rule 3: universal slash upgrade)
U+17C3 + [K_SLASH] > U+17B2   c =/ (Rule 3: universal slash upgrade)
U+17B2 + [K_SLASH] > U+17CE   c =// (Rule 3: universal slash upgrade)
U+17E1 + [K_SLASH] > U+0021   c 1/ (Rule 3: universal slash upgrade)
U+17E2 + [K_SLASH] > U+17D7   c 2/ (Rule 3: universal slash upgrade)
U+17E3 + [K_SLASH] > U+0022   c 3/ (Rule 3: universal slash upgrade)
U+0022 + [K_SLASH] > U+17D1   c 3// (Rule 3: universal slash upgrade)
U+17E4 + [K_SLASH] > U+17DB   c 4/ (Rule 3: universal slash upgrade)
U+17E5 + [K_SLASH] > U+0025   c 5/ (Rule 3: universal slash upgrade)
U+17E6 + [K_SLASH] > U+17CD   c 6/ (Rule 3: universal slash upgrade)
U+17CD + [K_SLASH] > U+17D9   c 6// (Rule 3: universal slash upgrade)
U+17E7 + [K_SLASH] > U+17D0   c 7/ (Rule 3: universal slash upgrade)
U+17D0 + [K_SLASH] > U+17DA   c 7// (Rule 3: universal slash upgrade)
U+17E8 + [K_SLASH] > U+17CF   c 8/ (Rule 3: universal slash upgrade)
U+17E9 + [K_SLASH] > U+0028   c 9/ (Rule 3: universal slash upgrade)
U+17E0 + [K_SLASH] > U+0029   c 0/ (Rule 3: universal slash upgrade)
U+17C1 + [K_A] > U+17C4   c ea (Rule 3: e then a -> au)
U+17C1 + [K_I] > U+17BE   c ei (Rule 3: e then i -> oe)
U+17BB + [K_A] > U+17BD   c ua (Rule 3: u then a -> ua)
U+17B6 + [K_I] > U+17C3   c ai (Rule 3: a then i -> ai)

c --- unshifted base layer (Normal) ---
+ [K_1] > U+17E1
+ [K_2] > U+17E2
